base {
  log_debug = off;
  log_info = on;
  log = stderr;
  daemon = on;
  redirector = iptables;
}

redsocks {
  // Listen on all interfaces so forwarded hotspot traffic can reach us
  // (PREROUTING REDIRECT rewrites dst to the incoming interface IP, not 127.0.0.1)
  bind = "0.0.0.0:12345";
  relay = "__PROXY_IP__:3128";
  type = http-connect;

  login = "edcguest";
  password = "edcguest";
}
